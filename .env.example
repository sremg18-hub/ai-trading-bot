# =============================================================================
# AI TRADING BOT - EJEMPLO DE VARIABLES DE ENTORNO
# =============================================================================

# =============================================================================
# API KEYS (REQUERIDAS)
# =============================================================================
ALPACA_KEY_ID=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# AI Providers (opcionales - si no se ponen, usa datos gratuitos)
PERPLEXITY_API_KEY=your_perplexity_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# MODO SCALPING AGRESIVO
# =============================================================================

# Intervalos (en milisegundos)
CHECK_INTERVAL_MS=8000          # Stocks: 8 segundos
EXIT_CHECK_MS=5000              # TP/SL: 5 segundos
CRYPTO_CHECK_INTERVAL_MS=45000  # Crypto: 45 segundos

# TP/SL para scalping
TAKE_PROFIT_PERCENT=0.15        # +0.15%
STOP_LOSS_PERCENT=0.4           # -0.4%
MAX_DAILY_LOSS_PERCENT=10       # 10% máximo

# =============================================================================
# STOCKS CONFIG
# =============================================================================
TRADE_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META
MAX_POSITION_SIZE=500
MAX_TOTAL_EXPOSURE=25000

# Pesos (suman 0.85, 0.15 es Alternative Data)
WEIGHT_TECHNICAL=0.425
WEIGHT_AI_NEWS=0.2975
WEIGHT_COPY=0.2125

# =============================================================================
# CRYPTO CONFIG  
# =============================================================================
CRYPTO_ENABLED=true
CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
CRYPTO_MAX_POSITION_SIZE=200
CRYPTO_MAX_TOTAL_EXPOSURE=15000

# Pesos crypto (suman 1.0)
CRYPTO_WEIGHT_TECHNICAL=0.50
CRYPTO_WEIGHT_AI_NEWS=0.25
CRYPTO_WEIGHT_MOMENTUM=0.25

# =============================================================================
# CACHÉ TTLs (milisegundos)
# =============================================================================

# IA (conservador)
AI_NEWS_CACHE_TTL_MS=1800000    # 30 min

# Fuentes gratuitas (frecuente)
YAHOO_CACHE_TTL_MS=120000       # 2 min
RSS_CACHE_TTL_MS=300000         # 5 min
BREADTH_CACHE_TTL_MS=180000     # 3 min

# Datos de mercado
MARKET_BARS_TTL_MS=300000       # 5 min
COINGECKO_CACHE_TTL_MS=900000   # 15 min

# =============================================================================
# SISTEMA
# =============================================================================
PORT=3000
STATE_FILE=/data/state.json
